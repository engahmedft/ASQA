<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- DEFAULT FOR LOCAL DEV / WATCH (DEBUG): No .exe, bypasses IT AppLocker completely -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- AUTOMATIC OVERRIDE FOR PUBLISH (RELEASE): Enables AppHost so Self-Contained build passes -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.*" />
    
    <!-- Prevent UseAppHost from leaking to the browser-wasm client -->
    <ProjectReference Include="..\ASQATools.Client\ASQATools.Client.csproj">
      <UndefineProperties>UseAppHost</UndefineProperties>
    </ProjectReference>
    <ProjectReference Include="..\ASQATools.Shared\ASQATools.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="App_Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="pr_reviews_data\**\*" />
    <None Remove="pr_reviews_data\**\*" />
    <Compile Remove="pr_reviews_data\**\*" />
  </ItemGroup>
</Project>
